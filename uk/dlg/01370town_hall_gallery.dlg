{1}{Маячня!}{Маячня!}{}{}{}{}
{2}{Смішно!}{Смішно!}{}{}{}{}
{3}{Абсурд!}{Абсурд!}{}{}{}{}
{4}{Дурниці!}{Дурниці!}{}{}{}{}
{5}{Нісенітниця!}{Нісенітниця!}{}{}{}{}
{6}{Та годі вам!}{Та годі вам!}{}{}{}{}
{7}{Я заперечую, пане!}{Я заперечую, пані!}{}{}{}{}
{8}{Оце вже навряд, старий друже!}{Оце вже навряд, пані!}{}{}{}{}
{9}{Ви несповна розуму!}{Ви несповна розуму!}{}{}{}{}
{10}{Щасти вам, воно вам знадобиться!}{Щасти вам, воно вам знадобиться!}{}{}{}{}
{11}{Атож, пане!}{Атож, пані!}{}{}{}{}
{12}{Влучно сказано.}{Влучно сказано.}{}{}{}{}
{13}{Славно!}{Славно!}{}{}{}{}
{14}{Слушно! Слушно!}{Слушно! Слушно!}{}{}{}{}
{15}{Непогана думка!}{Непогана думка!}{}{}{}{}
{16}{Чудово!}{Чудово!}{}{}{}{}
{17}{Гіп-гіп, ура!}{Гіп-гіп, ура!}{}{}{}{}
{18}{Блискуче!}{Блискуче!}{}{}{}{}
{19}{Браво!}{Браво!}{}{}{}{}
{20}{Приголомшливо!}{Приголомшливо!}{}{}{}{}
{21}{Хай живуть бійці!}{Хай живуть бійці!}{}{}{}{}
{22}{Зробімо це як слід.}{Зробімо це як слід.}{}{}{}{}
{23}{Міська площа!}{Міська площа!}{}{}{}{}
{24}{Біля брами!}{Біля брами!}{}{}{}{}
{25}{Поспішати нікуди.}{Поспішати нікуди.}{}{}{}{}
{26}{Статуя нам не по кишені!}{Статуя нам не по кишені!}{}{}{}{}
{27}{Яка ціна, така й річ!}{Яка ціна, така й річ!}{}{}{}{}
{28}{Хай живе Ерік!}{Хай живе Ерік!}{}{}{}{}
{29}{Нічого дешевого для Ешбері!}{Нічого дешевого для Ешбері!}{}{}{}{}
{30}{Бронза! Який величний матеріал!}{Бронза! Який величний матеріал!}{}{}{}{}
{31}{Поки натовп захоплений зборами — легка пожива.}{Поки натовп захоплений зборами — легка пожива.}{}{}{}{}
